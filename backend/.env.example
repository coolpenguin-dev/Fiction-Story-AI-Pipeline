OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.5
# HTTP timeout in seconds for OpenAI calls (default 300)
# OPENAI_TIMEOUT=300
# Retries on connection/timeout/5xx/rate-limit (default 3 attempts)
# OPENAI_MAX_RETRIES=3
# OPENAI_RETRY_BASE_SECONDS=2
# Max parallel PDFs in /api/analyze-batch (1–5, default 3)
# ANALYZE_BATCH_CONCURRENCY=3

# Pinecone (optional)
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX_NAME=fiction-ai
# Recommended for production (get from Pinecone console)
# PINECONE_INDEX_HOST=your-index-host.svc.us-east1-aws.pinecone.io
# PINECONE_NAMESPACE=fiction
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
